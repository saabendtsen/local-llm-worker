diff --git a/scripts/status_page.py b/scripts/status_page.py
index 1ae0849..265b58f 100644
--- a/scripts/status_page.py
+++ b/scripts/status_page.py
@@ -632,7 +632,21 @@ class _StatusHandler(BaseHTTPRequestHandler):
 
             # Table for this group's runs.
             rows: list[str] = []
-            for run in result["recent"]:
+
+            # Collect running runs for this group, then finished runs
+            # (capped at 10 by *recent*).  Both lists are already sorted
+            # newest-first by ``started_at``.
+            group_running = [
+                r for r in result["running"]
+                if r.get("pipeline") == group["pipeline"]
+            ]
+            group_finished = [
+                r for r in result["recent"]
+                if r.get("pipeline") == group["pipeline"]
+            ]
+            group_runs = group_running + group_finished
+
+            for run in group_runs:
                 if run.get("pipeline") != group["pipeline"]:
                     continue
                 r_title = _html.escape(str(run.get("title", "")))
diff --git a/tests/test_status_page.py b/tests/test_status_page.py
