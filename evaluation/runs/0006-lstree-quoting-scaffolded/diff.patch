+    def test_inventory_reports_removed_credential_as_history_only(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            # Non-ASCII name: triggers encoding path that was the original defect.
+            secret_file = repository / "secret-v\u00e4rden.env"
+            secret_file.write_text("api_key=should-not-leak\n", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add secret")
+            # Remove the file so it is no longer in HEAD.
+            secret_file.unlink()
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "remove secret")
+
+            report = scanner.inventory(repository)
+
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            self.assertIn("secret-v\u00e4rden.env", by_path)
+            self.assertEqual(by_path["secret-v\u00e4rden.env"]["status"], "history-only")
+
