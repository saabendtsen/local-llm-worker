@@ -0,0 +1,336 @@
+"""Tests for scripts/report-migration-coverage.py."""
+from __future__ import annotations
+
+import collections
+import importlib.util
+import json
+import pathlib
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).parents[1]
+SCRIPT_PATH = ROOT / "scripts" / "report-migration-coverage.py"
+REGISTRY_PATH = ROOT / "inventories" / "migration-unit-registry-2026-08-08.json"
+
+# Load the script via importlib (hyphenated name is not importable)
+_SPEC = importlib.util.spec_from_file_location(
+    "report_migration_coverage", SCRIPT_PATH
+)
+_mod = importlib.util.module_from_spec(_SPEC)
+assert _SPEC.loader
+_SPEC.loader.exec_module(_mod)
+report_migration_coverage = _mod.report_migration_coverage
+
+PERMITTED = ("migrate", "consolidate", "archive", "retain in place", "discard")
+
+LEDGER_NAMES = sorted(p.name for p in (ROOT / "inventories").glob("*-dispositions-*.json"))
+
+
+class RealDataTests(unittest.TestCase):
+    """Case 1: the real checked-in data."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.registry = json.loads(
+            REGISTRY_PATH.read_text(encoding="utf-8")
+        )
+        ledger_dir = REGISTRY_PATH.parent
+        ledgers = []
+        for lp in sorted(ledger_dir.glob("*-dispositions-*.json")):
+            data = json.loads(lp.read_text(encoding="utf-8"))
+            data["source_file"] = str(lp)
+            ledgers.append(data)
+        cls.ledgers = ledgers
+
+    def test_totals(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        self.assertEqual(report["summary"]["total_registry_units"], 1613)
+        self.assertEqual(report["summary"]["decided"], 1613)
+        self.assertEqual(report["summary"]["undecided"], 0)
+        self.assertTrue(report["summary"]["coverage_complete"])
+
+    def test_no_anomalies(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        self.assertEqual(len(report["anomalies"]), 0)
+
+    def test_disposition_totals(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        expected = {
+            "migrate": 61,
+            "consolidate": 114,
+            "archive": 209,
+            "retain in place": 264,
+            "discard": 965,
+        }
+        self.assertEqual(report["disposition_totals"], expected)
+
+    def test_all_eight_kinds_present(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        for kind in ("automation_mechanism", "configuration", "data_collection",
+                      "document_collection", "memory_source", "repository",
+                      "service", "skill"):
+            with self.subTest(kind=kind):
+                self.assertIn(kind, report["kinds"])
+
+    def test_per_kind_sum_to_total(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        total_from_kinds = sum(
+            v["decided"] for v in report["kinds"].values()
+        )
+        self.assertEqual(total_from_kinds, report["summary"]["decided"])
+
+    def test_per_kind_dispositions_sum_to_decided(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        for kind, data in report["kinds"].items():
+            with self.subTest(kind=kind):
+                disp_sum = sum(data[d] for d in PERMITTED)
+                self.assertEqual(disp_sum, data["decided"])
+
+    def test_ledger_provenance_counts(self):
+        report = report_migration_coverage(self.registry, self.ledgers)
+        ledgers_reported = {l["path"] for l in report["ledgers"]}
+        ledger_names = {p.name for p in (ROOT / "inventories").glob("*-dispositions-*.json")}
+        # Each ledger's filename must appear in at least one provenance path
+        for ln in ledger_names:
+            self.assertTrue(
+                any(ln in lp for lp in ledgers_reported),
+                f"Ledger {ln} not found in provenance among {ledgers_reported}",
+            )
+        # Also check that we have the right number of ledger entries
+        self.assertEqual(len(report["ledgers"]), len(ledger_names))
+
+    def test_retain_in_place_survives_round_trip(self):
+        """Case 6: 'retain in place' with its space intact."""
+        report = report_migration_coverage(self.registry, self.ledgers)
+        for kind_data in report["kinds"].values():
+            self.assertIn("retain in place", kind_data)
+        self.assertIn("retain in place", report["disposition_totals"])
+
+
+class DuplicateLedgerTest(unittest.TestCase):
+    """Case 2: a unit decided in two ledgers."""
+
+    def setUp(self):
+        self.registry = {
+            "migration_units": [
+                {"id": "skill-aaa111", "kind": "skill", "name": "test"},
+            ]
+        }
+        self.ledger_a = {
+            "decisions": [
+                {
+                    "id": "skill-aaa111",
+                    "disposition": "migrate",
+                }
+            ]
+        }
+        self.ledger_b = {
+            "decisions": [
+                {
+                    "id": "skill-aaa111",
+                    "disposition": "archive",
+                }
+            ]
+        }
+
+    def test_counted_once_as_decided(self):
+        report = report_migration_coverage(self.registry, [self.ledger_a, self.ledger_b])
+        self.assertEqual(report["summary"]["decided"], 1)
+        self.assertEqual(report["summary"]["undecided"], 0)
+
+    def test_kind_disposition_counts_sum_to_one(self):
+        report = report_migration_coverage(self.registry, [self.ledger_a, self.ledger_b])
+        kind_data = report["kinds"]["skill"]
+        total = sum(kind_data[d] for d in PERMITTED)
+        self.assertEqual(total, 1)
+
+    def test_flagged_as_duplicate(self):
+        report = report_migration_coverage(self.registry, [self.ledger_a, self.ledger_b])
+        dup_anomalies = [a for a in report["anomalies"] if a["type"] == "duplicate"]
+        self.assertEqual(len(dup_anomalies), 1)
+        self.assertIn("skill-aaa111", dup_anomalies[0]["unit_ids"])
+
+
+class UnknownUnitTest(unittest.TestCase):
+    """Case 3: a decision for a unit not in the registry."""
+
+    def setUp(self):
+        self.registry = {
+            "migration_units": [
+                {"id": "skill-aaa111", "kind": "skill", "name": "test"},
+            ]
+        }
+        self.ledger = {
+            "decisions": [
+                {
+                    "id": "skill-aaa111",
+                    "disposition": "migrate",
+                },
+                {
+                    "id": "skill-unknown999",
+                    "disposition": "archive",
+                },
+            ]
+        }
+
+    def test_unknown_unit_flagged(self):
+        report = report_migration_coverage(self.registry, [self.ledger])
+        unknown_anomalies = [
+            a for a in report["anomalies"] if a["type"] == "unknown_unit"
+        ]
+        self.assertEqual(len(unknown_anomalies), 1)
+        self.assertIn("skill-unknown999", unknown_anomalies[0]["unit_ids"])
+
+    def test_not_counted_toward_any_kind(self):
+        report = report_migration_coverage(self.registry, [self.ledger])
+        # Only skill-aaa111 is in the registry; unknown is ignored
+        self.assertEqual(report["kinds"]["skill"]["decided"], 1)
+        self.assertEqual(report["summary"]["decided"], 1)
+
+    def test_no_traceback(self):
+        """Regression: must not raise on unknown unit."""
+        report_migration_coverage(self.registry, [self.ledger])
+        self.assertTrue(True)
+
+
+class NoLedgersTest(unittest.TestCase):
+    """Case 4: no ledgers at all — every unit undecided."""
+
+    def setUp(self):
+        self.registry = {
+            "migration_units": [
+                {"id": "skill-aaa111", "kind": "skill", "name": "s1"},
+                {"id": "repo-bbb222", "kind": "repository", "name": "r1"},
+            ]
+        }
+
+    def test_all_undecided(self):
+        report = report_migration_coverage(self.registry, [])
+        self.assertEqual(report["summary"]["total_registry_units"], 2)
+        self.assertEqual(report["summary"]["decided"], 0)
+        self.assertEqual(report["summary"]["undecided"], 2)
+        self.assertFalse(report["summary"]["coverage_complete"])
+
+    def test_no_anomalies_for_undecided(self):
+        """Undecided is not flagged as an anomaly when there are truly no ledgers."""
+        report = report_migration_coverage(self.registry, [])
+        # The undecided anomaly should NOT fire when there are no ledgers at all,
+        # because there's no indication that a disposition is missing —
+        # it's a valid empty state.
+        undecided_anomalies = [a for a in report["anomalies"] if a["type"] == "undecided"]
+        self.assertEqual(len(undecided_anomalies), 0)
+
+
+class InvalidDispositionTest(unittest.TestCase):
+    """Case 5: a disposition outside the five permitted terms."""
+
+    def setUp(self):
+        self.registry = {
+            "migration_units": [
+                {"id": "skill-aaa111", "kind": "skill", "name": "test"},
+            ]
+        }
+        self.ledger = {
+            "decisions": [
+                {
+                    "id": "skill-aaa111",
+                    "disposition": "retire",
+                }
+            ]
+        }
+
+    def test_invalid_disposition_flagged(self):
+        report = report_migration_coverage(self.registry, [self.ledger])
+        invalid_anomalies = [
+            a for a in report["anomalies"] if a["type"] == "invalid_disposition"
+        ]
+        self.assertEqual(len(invalid_anomalies), 1)
+        self.assertIn("skill-aaa111", invalid_anomalies[0]["unit_ids"])
+
+    def test_invalid_disposition_not_counted(self):
+        """Invalid disposition should not contribute to any kind's disposition counts."""
+        report = report_migration_coverage(self.registry, [self.ledger])
+        kind_data = report["kinds"]["skill"]
+        for d in PERMITTED:
+            self.assertEqual(kind_data[d], 0)
+
+
+class CLIOutputTests(unittest.TestCase):
+    """Integration tests for the CLI entry point."""
+
+    def test_output_file(self):
+        with tempfile.TemporaryDirectory() as tmpdir:
+            tmp = pathlib.Path(tmpdir)
+            # Minimal registry + one ledger
+            reg = {
+                "migration_units": [
+                    {"id": "skill-aaa111", "kind": "skill", "name": "test"},
+                ]
+            }
+            reg_path = tmp / "reg.json"
+            reg_path.write_text(json.dumps(reg), encoding="utf-8")
+            ledger_path = tmp / "ledger.json"
+            ledger_path.write_text(
+                json.dumps(
+                    {
+                        "decisions": [
+                            {"id": "skill-aaa111", "disposition": "migrate"},
+                        ]
+                    }
+                ),
+                encoding="utf-8",
+            )
+            out_path = tmp / "report.json"
+
+            result = subprocess.run(
+                [
+                    "python",
+                    str(SCRIPT_PATH),
+                    str(reg_path),
+                    "--ledger",
+                    str(ledger_path),
+                    "--output",
+                    str(out_path),
+                ],
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(result.returncode, 0)
+            self.assertTrue(out_path.exists())
+            report = json.loads(out_path.read_text(encoding="utf-8"))
+            self.assertTrue(report["summary"]["coverage_complete"])
+
+    def test_missing_registry_exits_nonzero(self):
+        import subprocess
+        result = subprocess.run(
+            [
+                "python",
+                str(SCRIPT_PATH),
+                "/nonexistent/path.json",
+            ],
+            capture_output=True,
+            text=True,
+        )
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue(result.stderr.strip())
+
+    def test_no_ledgers_exits_nonzero(self):
+        """With --ledger and --ledger-dir both missing and no glob matches, exit non-zero."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            tmp = pathlib.Path(tmpdir)
+            reg = {"migration_units": []}
+            reg_path = tmp / "reg.json"
