index 0000000..c4a58a9
--- /dev/null
+++ b/scripts/report-migration-coverage.py
@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+"""Report migration-disposition coverage across all ledgers."""
+from __future__ import annotations
+
+import argparse
+import json
+import pathlib
+import sys
+from collections import Counter
+from typing import Any
+
+PERMITTED_DISPOSITIONS: tuple[str, ...] = (
+    "migrate",
+    "consolidate",
+    "archive",
+    "retain in place",
+    "discard",
+)
+
+_LEDGER_FILENAME_PATTERN = "*-dispositions-*.json"
+
+
+def report_migration_coverage(
+    registry: dict[str, Any],
+    ledgers: list[dict[str, Any]],
+) -> dict[str, Any]:
+    """Build a coverage report joining the registry against every ledger.
+
+    Parameters
+    ----------
+    registry:
+        Parsed registry JSON (the ``migration_units`` list must be present).
+    ledgers:
+        Parsed ledger JSON objects, each containing a ``decisions`` list.
+
+    Returns
+    -------
+    dict
+        The report data structure.
+    """
+    units: list[dict[str, Any]] = registry.get("migration_units", [])
+    unit_by_id: dict[str, dict[str, Any]] = {u["id"]: u for u in units}
+    unit_kind: dict[str, str] = {u["id"]: u["kind"] for u in units}
+
+    registry_ids: set[str] = set(unit_by_id)
+    kind_set: set[str] = set(unit_kind.values())
+
+    # ---- accumulate per-kind stats ----
+    kind_registry: dict[str, int] = Counter(unit_kind.values())
+    kind_decided: dict[str, set[str]] = {k: set() for k in kind_set}
+    kind_disposition: dict[str, Counter] = {
+        k: Counter() for k in kind_set
+    }
+
+    # ---- track ledger provenance & decisions ----
+    ledger_provenance: list[dict[str, Any]] = []
+    all_decisions_by_id: dict[str, list[dict[str, Any]]] = {}
+    all_decision_ids: set[str] = set()
+    seen_ids_first_disposition: dict[str, str] = {}
+
+    has_any_ledger = bool(ledgers)
+
+    for ledger in ledgers:
+        decisions: list[dict[str, Any]] = ledger.get("decisions", [])
+        ledger_path = ledger.get("source_file", "unknown")
+        decision_count = len(decisions)
+
+        ledger_provenance.append(
+            {
+                "path": str(ledger_path),
+                "decision_count": decision_count,
+            }
+        )
+
+        for dec in decisions:
+            dec_id: str = dec["id"]
+            disposition: str = dec.get("disposition", "")
+            all_decision_ids.add(dec_id)
+            all_decisions_by_id.setdefault(dec_id, []).append(dec)
+
+            if dec_id in unit_by_id:
+                kind = unit_kind[dec_id]
+                # Count each unit only once, using the first ledger's disposition
+                if dec_id not in seen_ids_first_disposition:
+                    seen_ids_first_disposition[dec_id] = disposition
+                    kind_decided[kind].add(dec_id)
+                    kind_disposition[kind][disposition] += 1
+
+    # ---- anomaly detection ----
+    anomalies: list[dict[str, Any]] = []
+
+    # Undecided units (in registry but no ledger decides them)
+    decided_all: set[str] = set()
+    for k in kind_set:
+        decided_all |= kind_decided[k]
+    undecided_ids = sorted(registry_ids - decided_all)
+
+    # Duplicate: decided by more than one ledger
+    duplicates: list[str] = sorted(
+        uid for uid, decs in all_decisions_by_id.items() if len(decs) > 1
+    )
+
+    # Unknown: decided but not in registry
+    unknown_ids = sorted(all_decision_ids - registry_ids)
+
+    # Invalid dispositions
+    invalid_dispositions: list[str] = sorted(
+        uid for uid, decs in all_decisions_by_id.items()
+        for dec in decs
+        if dec.get("disposition", "") not in PERMITTED_DISPOSITIONS
+    )
+
+    if undecided_ids and has_any_ledger:
+        anomalies.append(
+            {
+                "type": "undecided",
+                "unit_ids": undecided_ids,
+                "message": (
+                    f"{len(undecided_ids)} registry unit(s) have no disposition"
+                ),
+            }
+        )
+    if duplicates:
+        anomalies.append(
+            {
+                "type": "duplicate",
+                "unit_ids": duplicates,
+                "message": (
+                    f"{len(duplicates)} unit(s) decided by more than one ledger"
+                ),
+            }
+        )
+    if unknown_ids:
+        anomalies.append(
+            {
+                "type": "unknown_unit",
+                "unit_ids": unknown_ids,
+                "message": (
+                    f"{len(unknown_ids)} decision(s) reference unit(s) not in registry"
+                ),
+            }
+        )
+    if invalid_dispositions:
+        anomalies.append(
+            {
+                "type": "invalid_disposition",
+                "unit_ids": invalid_dispositions,
+                "message": (
+                    f"{len(invalid_dispositions)} decision(s) have disposition outside permitted vocabulary"
+                ),
+            }
+        )
+
+    # ---- aggregate disposition totals ----
+    aggregate_dispositions: Counter = Counter()
+    for k in kind_set:
+        aggregate_dispositions += kind_disposition[k]
+
+    # Build per-kind breakdown
+    kinds_breakdown: dict[str, Any] = {}
+    for k in sorted(kind_set):
+        kinds_breakdown[k] = {
+            "registry_count": kind_registry.get(k, 0),
+            "decided": len(kind_decided.get(k, set())),
+            "undecided": kind_registry.get(k, 0) - len(kind_decided.get(k, set())),
+        }
+        for disp in PERMITTED_DISPOSITIONS:
+            kinds_breakdown[k][disp] = kind_disposition[k].get(disp, 0)
+
+    total_decided = len(decided_all & registry_ids)
+    total_undecided = len(undecided_ids)
+
+    report: dict[str, Any] = {
+        "summary": {
+            "total_registry_units": len(registry_ids),
+            "decided": total_decided,
+            "undecided": total_undecided,
+            "coverage_complete": total_undecided == 0,
+        },
+        "kinds": kinds_breakdown,
+        "disposition_totals": dict(aggregate_dispositions),
+        "ledgers": ledger_provenance,
+        "anomalies": anomalies,
+    }
+    return report
+
+
+def _discover_ledger_paths(ledger_dir: pathlib.Path) -> list[pathlib.Path]:
+    """Return sorted ledger paths under *ledger_dir* matching the pattern."""
+    return sorted(
+        ledger_dir.glob(_LEDGER_FILENAME_PATTERN),
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        description="Report migration-disposition coverage across ledgers.",
+    )
+    parser.add_argument(
+        "registry",
+        help="Path to the migration-unit registry JSON.",
+    )
+    parser.add_argument(
+        "--ledger",
+        action="append",
+        default=None,
+        help="Path to a disposition ledger JSON. May be repeated.",
+    )
+    parser.add_argument(
+        "--ledger-dir",
+        type=pathlib.Path,
+        default=None,
+        help=(
+            "Directory to auto-discover *-dispositions-*.json ledgers in. "
+            "Used only when --ledger is not supplied."
+        ),
+    )
+    parser.add_argument(
+        "-o",
+        "--output",
+        type=pathlib.Path,
+        default=None,
+        help="Write report JSON to this path (default: stdout).",
+    )
+
+    args = parser.parse_args()
+
+    # Load registry
+    try:
+        registry_text = pathlib.Path(args.registry).read_text(encoding="utf-8")
+        registry = json.loads(registry_text)
+    except (OSError, json.JSONDecodeError) as exc:
+        print(f"Error reading registry: {exc}", file=sys.stderr)
+        return 1
+
+    # Collect ledger paths
+    if args.ledger:
+        ledger_paths: list[pathlib.Path] = [pathlib.Path(p) for p in args.ledger]
+    elif args.ledger_dir:
+        ledger_paths = _discover_ledger_paths(args.ledger_dir)
+    else:
+        # Auto-discover in the same directory as the registry
+        registry_dir = pathlib.Path(args.registry).parent
+        ledger_paths = _discover_ledger_paths(registry_dir)
+
+    if not ledger_paths:
+        print("No ledgers found.", file=sys.stderr)
+        return 1
+
+    # Load ledgers
+    ledgers: list[dict[str, Any]] = []
+    for lp in ledger_paths:
+        try:
+            text = lp.read_text(encoding="utf-8")
+            data = json.loads(text)
+            data["source_file"] = str(lp)
+            ledgers.append(data)
+        except (OSError, json.JSONDecodeError) as exc:
+            print(f"Error reading ledger {lp}: {exc}", file=sys.stderr)
+            return 1
+
+    report = report_migration_coverage(registry, ledgers)
+    output_text = json.dumps(report, indent=2) + "\n"
+
+    if args.output:
+        try:
+            args.output.write_text(output_text, encoding="utf-8")
+        except OSError as exc:
+            print(f"Error writing output: {exc}", file=sys.stderr)
+            return 1
+    else:
+        print(output_text, end="")
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
