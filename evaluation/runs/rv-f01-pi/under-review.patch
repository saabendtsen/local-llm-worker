+#!/usr/bin/env python3
+"""Report migration-disposition coverage across ledgers."""
+
+from __future__ import annotations
+
+import argparse
+import collections
+import glob
+import json
+import sys
+from pathlib import Path
+
+PERMITTED_DISPOSITIONS = (
+    "migrate",
+    "consolidate",
+    "archive",
+    "retain in place",
+    "discard",
+)
+LEGEND = {
+    "migrate": "migrate",
+    "consolidate": "consolidate",
+    "archive": "archive",
+    "retain in place": "retain in place",
+    "discard": "discard",
+}
+
+
+def build_report(
+    registry: dict,
+    ledger_paths: list[tuple[str, dict]],
+) -> dict:
+    """Read registry + ledger data structures and produce a coverage report.
+
+    Parameters
+    ----------
+    registry:
+        Parsed migration-unit registry (the dict from the JSON file).
+    ledger_paths:
+        Pairs of (ledger_file_path_string, parsed ledger dict).
+
+    Returns
+    -------
+    dict
+        The coverage report as a plain data structure suitable for
+        ``json.dumps`` serialisation.
+    """
+    units = registry.get("migration_units", [])
+    unit_ids: set[str] = {u["id"] for u in units}
+    kind_counts: collections.Counter = collections.Counter(
+        u["kind"] for u in units
+    )
+
+    # Per-ledger decisions: list of (ledger_path, decisions_list).
+    ledgers: list[tuple[str, list[dict]]] = []
+    for _path, data in ledger_paths:
+        decisions = data.get("decisions", [])
+        ledgers.append((_path, decisions))
+
+    # --- anomaly tracking ---
+    id_to_ledgers: dict[str, list[str]] = collections.defaultdict(list)
+    id_to_dispositions: dict[str, list[str]] = collections.defaultdict(list)
+    unknown_ids: list[str] = []
+    invalid_dispositions: list[dict] = []
+
+    for ledger_path, decisions in ledgers:
+        for dec in decisions:
+            uid = dec.get("id", "<missing-id>")
+            disp = dec.get("disposition", "")
+            id_to_ledgers[uid].append(ledger_path)
+            id_to_dispositions[uid].append(disp)
+            if uid not in unit_ids:
+                if uid not in unknown_ids:
+                    unknown_ids.append(uid)
+            if disp not in PERMITTED_DISPOSITIONS:
+                invalid_dispositions.append(
+                    {
+                        "type": "invalid_disposition",
+                        "id": uid,
+                        "disposition": disp,
+                        "ledger": ledger_path,
+                    }
+                )
+
+    # --- decided set and counts ---
+    decided_ids: set[str] = set(id_to_ledgers.keys()) & unit_ids
+    undecided_ids: set[str] = unit_ids - decided_ids
+    duplicate_ids = [
+        uid for uid, ledgers_list in id_to_ledgers.items() if len(ledgers_list) > 1
+    ]
+
+    # --- aggregate disposition counts (deduplicated per unit) ---
+    # For each decided unit, count its *first* disposition seen across ledgers
+    # to avoid double-counting when a unit is decided in multiple ledgers.
+    aggregate_counts: collections.Counter = collections.Counter()
+    kind_dispositions: dict[str, collections.Counter] = collections.defaultdict(
+        lambda: collections.Counter()
+    )
+
+    # Build kind lookup from registry
+    unit_kind: dict[str, str] = {}
+    for u in units:
+        unit_kind[u["id"]] = u["kind"]
+
+    for uid in sorted(decided_ids):
+        first_disp = id_to_dispositions[uid][0]
+        if first_disp in PERMITTED_DISPOSITIONS:
+            aggregate_counts[first_disp] += 1
+            k = unit_kind.get(uid, "unknown")
+            kind_dispositions[k][first_disp] += 1
+
+    # --- per-kind breakdown ---
+    all_kinds = sorted(kind_counts.keys())
+    kind_breakdown: list[dict] = []
+    for kind in all_kinds:
+        entry: dict[str, object] = {
+            "kind": kind,
+            "registry_count": kind_counts[kind],
+            "decided_count": sum(kind_dispositions[kind].values()),
+            "undecided_count": kind_counts[kind]
+            - sum(kind_dispositions[kind].values()),
+        }
+        for disp in PERMITTED_DISPOSITIONS:
+            entry[disp] = kind_dispositions[kind].get(disp, 0)
+        kind_breakdown.append(entry)
+
+    # --- ledger provenance ---
+    ledger_provenance: list[dict] = []
+    for ledger_path, decisions in ledgers:
+        counts: collections.Counter = collections.Counter()
+        for dec in decisions:
+            disp = dec.get("disposition", "")
+            counts[disp] += 1
+        ledger_entry: dict[str, object] = {
+            "path": ledger_path,
+            "decision_count": len(decisions),
+        }
+        for disp in PERMITTED_DISPOSITIONS:
+            ledger_entry[disp] = counts.get(disp, 0)
+        ledger_provenance.append(ledger_entry)
+
+    # --- anomalies list ---
+    anomalies: list[dict] = []
+
+    for uid in sorted(undecided_ids):
+        anomalies.append(
+            {
+                "type": "undecided",
+                "id": uid,
+                "kind": unit_kind.get(uid, "unknown"),
+            }
+        )
+
+    for uid in sorted(duplicate_ids):
+        anomalies.append(
+            {
+                "type": "duplicate",
+                "id": uid,
+                "ledgers": id_to_ledgers[uid],
+                "dispositions": id_to_dispositions[uid],
+            }
+        )
+
+    for uid in sorted(unknown_ids):
+        anomalies.append(
+            {
+                "type": "unknown_unit",
+                "id": uid,
+            }
+        )
+
+    for inv in invalid_dispositions:
+        anomalies.append(inv)
+
+    coverage_complete = len(undecided_ids) == 0
+
+    report: dict = {
+        "summary": {
+            "total_registry_units": len(unit_ids),
+            "total_decided": len(decided_ids),
+            "total_undecided": len(undecided_ids),
+            "coverage_complete": coverage_complete,
+        },
+        "aggregate": dict(aggregate_counts),
+        "kind_breakdown": kind_breakdown,
+        "ledger_provenance": ledger_provenance,
+        "anomalies": anomalies,
+        "anomaly_counts": {
+            "undecided": len(undecided_ids),
+            "duplicates": len(duplicate_ids),
+            "unknown_units": len(unknown_ids),
+            "invalid_dispositions": len(invalid_dispositions),
+        },
+    }
+
+    return report
+
+
+def _render_text(report: dict) -> str:
+    """Render the report as human-readable text."""
+    lines: list[str] = []
+    s = report["summary"]
+    lines.append("Migration Disposition Coverage Report")
+    lines.append("=" * 40)
+    lines.append(
+        f"Registry units: {s['total_registry_units']}"
+    )
+    lines.append(
+        f"Decided: {s['total_decided']}"
+    )
+    lines.append(
+        f"Undecided: {s['total_undecided']}"
+    )
+    lines.append(
+        f"Coverage: {'complete' if s['coverage_complete'] else 'INCOMPLETE'}"
+    )
+    lines.append("")
+
+    lines.append("Aggregate dispositions")
+    lines.append("-" * 40)
+    for disp in PERMITTED_DISPOSITIONS:
+        count = report["aggregate"].get(disp, 0)
+        if count:
+            lines.append(f"  {disp}: {count}")
+    lines.append("")
+
+    lines.append("Per-kind breakdown")
+    lines.append("-" * 40)
+    for kb in report["kind_breakdown"]:
+        lines.append(f"  {kb['kind']}:")
+        lines.append(
+            f"    registry={kb['registry_count']}, "
+            f"decided={kb['decided_count']}, "
+            f"undecided={kb['undecided_count']}"
+        )
+        for disp in PERMITTED_DISPOSITIONS:
+            c = kb.get(disp, 0)
+            if c:
+                lines.append(f"      {disp}: {c}")
+    lines.append("")
+
+    lines.append("Ledger provenance")
+    lines.append("-" * 40)
+    for lp in report["ledger_provenance"]:
+        lines.append(f"  {lp['path']}: {lp['decision_count']} decisions")
+        for disp in PERMITTED_DISPOSITIONS:
+            c = lp.get(disp, 0)
+            if c:
+                lines.append(f"    {disp}: {c}")
+    lines.append("")
+
+    anomalies = report["anomalies"]
+    if anomalies:
+        lines.append("Anomalies")
+        lines.append("-" * 40)
+        for a in anomalies:
+            lines.append(
+                f"  [{a['type']}] {a['id']}"
+            )
+    else:
+        lines.append("No anomalies detected.")
+
+    lines.append("")
+    return "\n".join(lines)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(
+        description="Report migration-disposition coverage across ledgers."
+    )
+    parser.add_argument(
+        "--registry",
+        type=Path,
+        required=True,
+        help="Path to the migration-unit registry JSON.",
+    )
+    parser.add_argument(
+        "--ledger",
+        type=Path,
+        action="append",
+        default=[],
+        help="Path to a disposition ledger JSON (repeatable).",
+    )
+    parser.add_argument(
+        "--ledger-dir",
+        type=Path,
+        default=None,
+        help="Directory to auto-discover *dispositions-*.json ledgers.",
+    )
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=None,
+        help="Write JSON report to this path instead of stdout.",
+    )
+    parser.add_argument(
+        "--text",
+        action="store_true",
+        default=False,
+        help="Render as text instead of JSON.",
+    )
+    args = parser.parse_args()
+
+    registry_path = args.registry
+    if not registry_path.is_file():
+        print(
+            f"error: registry not found: {registry_path}",
+            file=sys.stderr,
+        )
+        return 1
+
+    registry = json.loads(
+        registry_path.read_text(encoding="utf-8"),
+    )
+    if "migration_units" not in registry:
+        print(
+            "error: registry JSON missing 'migration_units' key",
+            file=sys.stderr,
+        )
+        return 1
+
+    ledger_paths: list[tuple[str, dict]] = []
+    for p in args.ledger:
+        if not p.is_file():
+            print(
+                f"error: ledger not found: {p}",
+                file=sys.stderr,
+            )
+            return 1
+        ledger_paths.append(
+            (
+                str(p),
+                json.loads(p.read_text(encoding="utf-8")),
+            )
+        )
+
+    if args.ledger_dir is not None:
+        if not args.ledger_dir.is_dir():
+            print(
+                f"error: ledger directory not found: {args.ledger_dir}",
+                file=sys.stderr,
+            )
+            return 1
+        for p in sorted(args.ledger_dir.glob("*dispositions-*.json")):
+            ledger_paths.append(
+                (
+                    str(p),
+                    json.loads(p.read_text(encoding="utf-8")),
+                )
+            )
+
+    if not ledger_paths and not args.ledger:
+        print(
+            "info: no ledgers provided; reporting all units as undecided",
+            file=sys.stderr,
+        )
+
+    report = build_report(registry, ledger_paths)
+
+    output_text: str
+    if args.text:
+        output_text = _render_text(report)
+    else:
+        output_text = json.dumps(report, indent=2) + "\n"
+
+    if args.output:
+        args.output.write_text(output_text, encoding="utf-8")
+    else:
+        sys.stdout.write(output_text)
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
