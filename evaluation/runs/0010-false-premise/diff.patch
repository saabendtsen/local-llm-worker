+    def test_chunks_preserves_partial_final_chunk(self):
+        # Regression: chunks() must emit the final partial batch when
+        # len(items) is not a multiple of size.
+        self.assertEqual(
+            [["a", "b"], ["c"]],
+            list(scanner.chunks(["a", "b", "c"], 2)),
+        )
+        self.assertEqual(
+            [["a", "b", "c"], ["d"]],
+            list(scanner.chunks(["a", "b", "c", "d"], 3)),
+        )
+        self.assertEqual(
+            [["a"]],
+            list(scanner.chunks(["a"], 3)),
+        )
+        self.assertEqual(
+            [],
+            list(scanner.chunks([], 5)),
+        )
