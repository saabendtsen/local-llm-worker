+def _run_wayfinder_cli(args: list[str], workspace: Path) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        [sys.executable, str(ROOT / "scripts" / "wayfinder_autopilot.py"),
+         "--workspace", str(workspace)] + args,
+        capture_output=True, text=True, check=False,
