     return parser
 
 
+def list_runs(config: AutopilotConfig, *, limit: int | None = None, states: list[str] | None = None) -> dict:
+    runs_dir = config.log_dir / HISTORY_RUNS_DIR
+    entries: list[dict] = []
+    if runs_dir.is_dir():
+        for child in runs_dir.iterdir():
+            if not child.is_dir():
+                continue
+            metadata_path = child / "run.json"
+            try:
+                metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+            except (json.JSONDecodeError, OSError):
+                entries.append({
+                    "run_id": child.name,
+                    "state": "unreadable",
+                    "dry_run": None,
+                    "started_at": None,
+                    "finished_at": None,
+                    "duration_seconds": None,
+                    "exit_code": None,
+                    "error": "failed to parse run.json",
+                    "events": None,
+                    "stderr": None,
+                    "final_message": None,
+                    "metadata": str(metadata_path),
+                })
+                continue
+            started = metadata.get("started_at")
+            finished = metadata.get("finished_at")
+            duration: float | None = None
+            if started and finished:
+                try:
+                    start_dt = datetime.fromisoformat(started)
+                    finish_dt = datetime.fromisoformat(finished)
+                    duration = round((finish_dt - start_dt).total_seconds(), 3)
+                except (ValueError, TypeError):
+                    pass
+            is_abandoned = False
+            if metadata.get("state") == "running" and started:
+                try:
+                    start_dt = datetime.fromisoformat(started)
+                    elapsed = (datetime.now().astimezone() - start_dt).total_seconds()
+                    if elapsed > SCHEDULER_CLEANUP_GRACE_SECONDS:
+                        is_abandoned = True
+                except (ValueError, TypeError):
+                    pass
+            entry = {
+                "run_id": metadata.get("run_id", child.name),
+                "state": metadata.get("state", "unknown"),
+                "dry_run": metadata.get("dry_run"),
+                "started_at": started,
+                "finished_at": finished,
+                "duration_seconds": duration,
+                "exit_code": metadata.get("exit_code"),
+                "error": metadata.get("error"),
+                "abandoned": is_abandoned,
+                "events": child.joinpath("events.jsonl") if (child / "events.jsonl").is_file() else None,
+                "stderr": child.joinpath("stderr.log") if (child / "stderr.log").is_file() else None,
+                "final_message": child.joinpath("final.md") if (child / "final.md").is_file() else None,
+                "metadata": str(metadata_path),
+            }
+            entries.append(entry)
+    # run_id is fixed-width timestamp, so lexicographic reverse == newest first
+    entries.sort(key=lambda e: e["run_id"], reverse=True)
+    if states:
+        entries = [e for e in entries if e["state"] in states]
+    if limit is not None:
+        entries = entries[:limit]
+    return {"state": HISTORY_STATE_OK, "runs": entries}
+
+
