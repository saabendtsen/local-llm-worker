@@ -127,6 +127,42 @@ print('{\"type\":\"result\",\"ok\":true}')
                 }
             )
 
+    def test_rejects_pathological_input_names(self):
+        rejected = ["", ".", "..", "foo/bar", "foo\\bar"]
+        inputs = {"name": "", "content_base64": base64.b64encode(b"x").decode()}
+        for name in rejected:
+            with self.subTest(name=name):
+                item = {**inputs, "name": name}
+                with self.assertRaisesRegex(
+                    ValueError, r"invalid or duplicate input name:"
+                ):
+                    self.bridge.submit(
+                        {
+                            "prompt": "inspect",
+                            "cwd": str(self.allowed),
+                            "mode": "inspect",
+                            "inputs": [item],
+                        }
+                    )
+
+    def test_accepts_dot_prefixed_names(self):
+        for name in [".gitignore", ".env.sample"]:
+            with self.subTest(name=name):
+                status = self.bridge.submit(
+                    {
+                        "prompt": "inspect",
+                        "cwd": str(self.allowed),
+                        "mode": "inspect",
+                        "inputs": [
+                            {
+                                "name": name,
+                                "content_base64": base64.b64encode(b"x").decode(),
+                            }
+                        ],
+                    }
+                )
+                self.assertEqual("queued", status["state"])
+
 
 if __name__ == "__main__":
     unittest.main()
