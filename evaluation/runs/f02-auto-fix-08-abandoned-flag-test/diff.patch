+    def test_list_runs_abandoned_stale_running_run(self):
+        """A running run with started_at decades ago is abandoned=True."""
+        runs_dir = self.logs / "runs"
+        runs_dir.mkdir(parents=True)
+        run_id = "20260816T120000-000000"
+        rd = runs_dir / run_id
+        rd.mkdir()
+        (rd / "run.json").write_text(
+            json.dumps({
+                "run_id": run_id,
+                "state": "running",
+                "started_at": "2000-01-01T00:00:00+00:00",
+            }),
+            encoding="utf-8",
+        )
+        result = list_runs(self.config)
+        entry = result["runs"][0]
+        self.assertTrue(entry["abandoned"])
+        self.assertIsNone(entry["duration_seconds"])
+
+    def test_list_runs_abandoned_fresh_running_run(self):
+        """A running run with started_at decades in the future is not abandoned."""
+        runs_dir = self.logs / "runs"
+        runs_dir.mkdir(parents=True)
+        run_id = "20260817T120000-000000"
+        rd = runs_dir / run_id
+        rd.mkdir()
+        (rd / "run.json").write_text(
+            json.dumps({
+                "run_id": run_id,
+                "state": "running",
+                "started_at": "2099-01-01T00:00:00+00:00",
+            }),
+            encoding="utf-8",
+        )
+        result = list_runs(self.config)
+        entry = result["runs"][0]
+        self.assertFalse(entry["abandoned"])
+
+    def test_list_runs_abandoned_completed_run_is_false(self):
