+    def test_non_ascii_path_status_is_current_when_in_head(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            # Non-ASCII directory with a credential-bearing file
+            (repository / "caf\u00e9").mkdir()
+            (repository / "caf\u00e9" / "credentials.json").write_text("{}", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add caf\u00e9/credentials.json")
+
+            report = scanner.inventory(repository)
+
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            # Key must exist and be classified as current, not history-only
+            self.assertIn("caf\u00e9/credentials.json", by_path)
+            self.assertEqual(by_path["caf\u00e9/credentials.json"]["status"], "current")
+
+    def test_removed_path_reports_history_only(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            (repository / "secrets.txt").write_text("data", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add secrets.txt")
+            (repository / "secrets.txt").unlink()
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "remove secrets.txt")
+
+            report = scanner.inventory(repository)
+
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            self.assertIn("secrets.txt", by_path)
+            self.assertEqual(by_path["secrets.txt"]["status"], "history-only")
+
