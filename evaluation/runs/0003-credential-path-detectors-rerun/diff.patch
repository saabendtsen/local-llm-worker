+    def test_config_file_detector_flags_netrc_npmrc_pypirc_kubeconfig(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            (repository / ".netrc").write_text(
+                "machine example.com login user password secret\n",
+                encoding="utf-8",
+            )
+            (repository / "config").mkdir()
+            (repository / "config" / ".npmrc").write_text(
+                "//registry.npmjs.org/:_authToken=abc123\n",
+                encoding="utf-8",
+            )
+            (repository / ".pypirc").write_text(
+                "[pypi]\npassword=p@ss\n",
+                encoding="utf-8",
+            )
+            (repository / "kubeconfig").write_text(
+                "apiVersion: v1\nclusters:\n- cluster:\n    server: https://example.com\n",
+                encoding="utf-8",
+            )
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add config files")
+
+            report = scanner.inventory(repository)
+
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            self.assertIn("config-file", by_path[".netrc"]["detector_categories"])
+            self.assertIn("config-file", by_path["config/.npmrc"]["detector_categories"])
+            self.assertIn("config-file", by_path[".pypirc"]["detector_categories"])
+            self.assertIn("config-file", by_path["kubeconfig"]["detector_categories"])
+
+    def test_config_file_detector_does_not_false_positive_on_similar_filenames(self):
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            (repository / "kubeconfig.yaml").write_text("data: true\n", encoding="utf-8")
+            (repository / ".netrc.backup").write_text("data: true\n", encoding="utf-8")
+            (repository / ".npmrc.local").write_text("data: true\n", encoding="utf-8")
+            (repository / "subdir").mkdir()
+            (repository / "subdir/.pypirc.bak").write_text("data: true\n", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add similar filenames")
+
+            report = scanner.inventory(repository)
+
+            detected_paths = {item["path"] for item in report["candidate_paths"]}
+            self.assertNotIn("kubeconfig.yaml", detected_paths)
+            self.assertNotIn(".netrc.backup", detected_paths)
+            self.assertNotIn(".npmrc.local", detected_paths)
+            self.assertNotIn("subdir/.pypirc.bak", detected_paths)
+
