+    def test_non_ascii_filename_reports_current(self):
+        """A non-ASCII tracked path must report status=current, not history-only."""
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            (repository / ".env.hemmelig-v\u00e6rdi").write_text("secret=foo\n", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "non-ascii env")
+
+            report = scanner.inventory(repository)
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            self.assertIn(".env.hemmelig-v\u00e6rdi", by_path)
+            self.assertEqual(by_path[".env.hemmelig-v\u00e6rdi"]["status"], "current")
+
+    def test_removed_path_reports_history_only(self):
+        """A path committed then deleted must still report status=history-only."""
+        with tempfile.TemporaryDirectory() as directory:
+            repository = pathlib.Path(directory)
+            self.git(repository, "init", "-b", "main")
+            self.git(repository, "config", "user.name", "Test")
+            self.git(repository, "config", "user.email", "test@example.invalid")
+            (repository / "secrets.yml").write_text("token: abc123\n", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "add secrets")
+            (repository / "secrets.yml").unlink()
+            (repository / "good.txt").write_text("ok\n", encoding="utf-8")
+            self.git(repository, "add", ".")
+            self.git(repository, "commit", "-m", "remove secrets")
+
+            report = scanner.inventory(repository)
+            by_path = {item["path"]: item for item in report["candidate_paths"]}
+            self.assertIn("secrets.yml", by_path)
+            self.assertEqual(by_path["secrets.yml"]["status"], "history-only")
+
