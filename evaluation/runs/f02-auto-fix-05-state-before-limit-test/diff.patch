+    def test_cli_history_state_and_limit(self):
+        """--state must filter before --limit slices.
+
+        Fixture has three completed runs (20260816-20260818).  We add one
+        failed run (20260819) to the fixture so that filtering for
+        ``--state failed`` then limiting to ``--limit 1`` returns the
+        single failed run.  If ``[:limit]`` ran before the state filter
+        the result would be ``[]``.
+        """
+        rd = self.runs_dir / "20260819T120000-000000"
+        rd.mkdir()
+        (rd / "run.json").write_text(
+            json.dumps({
+                "run_id": "20260819T120000-000000",
+                "state": "failed",
+                "dry_run": False,
+                "started_at": "2026-08-16T15:55:03+02:00",
+                "finished_at": "2026-08-16T15:55:07+02:00",
+                "exit_code": 1,
+                "workspace": str(self.workspace),
+            }),
+            encoding="utf-8",
+        )
+        try:
+            proc = _run_wayfinder_cli(
+                ["history", "--state", "failed", "--limit", "1"], self.workspace
+            )
+            self.assertEqual(0, proc.returncode)
+            data = json.loads(proc.stdout)
+            self.assertEqual(1, len(data["runs"]))
+            self.assertEqual("20260819T120000-000000", data["runs"][0]["run_id"])
+            self.assertEqual("failed", data["runs"][0]["state"])
+        finally:
+            import shutil
+            if rd.exists():
+                shutil.rmtree(rd)
+
