+    def test_list_runs_state_filter_before_limit(self):
+        """Filtering by state must happen before slicing by limit.
+
+        Four runs: 20260816T completed, 20260817T failed,
+        20260818T completed, 20260819T completed.
+        ``list_runs(states=["failed"], limit=1)`` must return exactly the
+        single failed run (20260817), not the empty list that results when
+        ``[:limit]`` runs before the state filter.
+        """
+        runs_dir = self.logs / "runs"
+        runs_dir.mkdir(parents=True)
+        for run_id, state in [
+            ("20260816T120000-000000", "completed"),
+            ("20260817T120000-000000", "failed"),
+            ("20260818T120000-000000", "completed"),
+            ("20260819T120000-000000", "completed"),
+        ]:
+            rd = runs_dir / run_id
+            rd.mkdir()
+            (rd / "run.json").write_text(
+                json.dumps({"run_id": run_id, "state": state}),
+                encoding="utf-8",
+            )
+        result = list_runs(self.config, states=["failed"], limit=1)
+        self.assertEqual(1, len(result["runs"]))
+        self.assertEqual("20260817T120000-000000", result["runs"][0]["run_id"])
+        self.assertEqual("failed", result["runs"][0]["state"])
+
+    def test_list_runs_limit_succeeds_completed_after_state_filter(self):
+        """Limit must select from the state-filtered set.
+
+        Same four runs as above.  ``list_runs(states=["completed"], limit=2)``
+        must return the two newest completed runs (20260819, 20260818),
+        not the two newest runs overall (which would include the failed one).
+        """
+        runs_dir = self.logs / "runs"
+        runs_dir.mkdir(parents=True)
+        for run_id, state in [
+            ("20260816T120000-000000", "completed"),
+            ("20260817T120000-000000", "failed"),
+            ("20260818T120000-000000", "completed"),
+            ("20260819T120000-000000", "completed"),
+        ]:
+            rd = runs_dir / run_id
+            rd.mkdir()
+            (rd / "run.json").write_text(
+                json.dumps({"run_id": run_id, "state": state}),
+                encoding="utf-8",
+            )
+        result = list_runs(self.config, states=["completed"], limit=2)
+        self.assertEqual(2, len(result["runs"]))
+        self.assertEqual(
+            ["20260819T120000-000000", "20260818T120000-000000"],
+            [r["run_id"] for r in result["runs"]],
+        )
+
