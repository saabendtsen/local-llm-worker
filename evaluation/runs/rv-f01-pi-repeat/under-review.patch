+#!/usr/bin/env python3
+"""Tests for scripts/report-migration-coverage.py."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import pathlib
+import tempfile
+import unittest
+
+
+ROOT = pathlib.Path(__file__).parents[1]
+SCRIPT_PATH = ROOT / "scripts" / "report-migration-coverage.py"
+SPEC = importlib.util.spec_from_file_location(
+    "report_migration_coverage", SCRIPT_PATH
+)
+assert SPEC is not None and SPEC.loader is not None
+coverage = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(coverage)
+
+
+REGISTRY_PATH = ROOT / "inventories" / "migration-unit-registry-2026-08-08.json"
+LEDGER_PATHS = sorted(
+    ROOT.glob("inventories/*-dispositions-*.json")
+)
+
+
+def _load(path: pathlib.Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+class RealDataTests(unittest.TestCase):
+    """Run the report against the checked-in registry and all eight ledgers."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.registry = _load(REGISTRY_PATH)
+        cls.ledgers = [(p, _load(p)) for p in LEDGER_PATHS]
+        cls.report = coverage.report_coverage(cls.registry, cls.ledgers)
+
+    def test_total_registry_units(self):
+        self.assertEqual(self.report["totals"]["registry_units"], 1613)
+
+    def test_total_decided(self):
+        self.assertEqual(self.report["totals"]["decided"], 1613)
+
+    def test_total_undecided(self):
+        self.assertEqual(self.report["totals"]["undecided"], 0)
+
+    def test_coverage_complete(self):
+        self.assertTrue(self.report["totals"]["coverage_complete"])
+
+    def test_no_duplicate_anomalies(self):
+        self.assertEqual(
+            self.report["anomalies"]["duplicate_decisions"]["count"], 0
+        )
+
+    def test_no_unknown_unit_anomalies(self):
+        self.assertEqual(
+            self.report["anomalies"]["unknown_units"]["count"], 0
+        )
+
+    def test_no_invalid_disposition_anomalies(self):
+        self.assertEqual(
+            self.report["anomalies"]["invalid_dispositions"]["count"], 0
+        )
+
+    def test_aggregate_totals(self):
+        agg = self.report["aggregate_dispositions"]
+        self.assertEqual(agg["migrate"], 61)
+        self.assertEqual(agg["consolidate"], 114)
+        self.assertEqual(agg["archive"], 209)
+        self.assertEqual(agg["retain in place"], 264)
+        self.assertEqual(agg["discard"], 965)
+
+    def test_per_kind_sum_matches_aggregate(self):
+        for kind_data in self.report["per_kind"].values():
+            total = sum(kind_data["dispositions"].values())
+            self.assertEqual(total, kind_data["registry_count"])
+
+    def test_provenance_records_all_ledgers(self):
+        self.assertEqual(len(self.report["provenance"]), 8)
+
+    def test_provenance_includes_path_and_count(self):
+        for prov in self.report["provenance"]:
+            self.assertIn("ledger", prov)
+            self.assertIn("decisions_count", prov)
+
+    def test_retain_in_place_survives_round_trip(self):
+        agg = self.report["aggregate_dispositions"]
+        self.assertIn("retain in place", agg)
+        self.assertEqual(agg["retain in place"], 264)
+
+
+class DuplicateDecisionTests(unittest.TestCase):
+    """A unit decided in two ledgers must count once and be flagged."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.tmpdir = tempfile.TemporaryDirectory()
+        cls.tdir = pathlib.Path(cls.tmpdir.name)
+        cls.registry_path = cls.tdir / "registry.json"
+        cls.ledger_a_path = cls.tdir / "a-dispositions.json"
+        cls.ledger_b_path = cls.tdir / "b-dispositions.json"
+
+        registry = {
+            "migration_units": [
+                {
+                    "id": "repo-001",
+                    "kind": "repository",
+                    "name": "test-repo",
+                    "categories": [],
+                    "disposition": "pending",
+                    "locations": [],
+                    "identities": {},
+                    "provenance": [],
+                    "reconciliation_status": "unreviewed",
+                    "sensitivity": "public",
+                }
+            ]
+        }
+        ledger_a = {
+            "schema_version": "1.0",
+            "decisions": [
+                {
+                    "id": "repo-001",
+                    "name": "test-repo",
+                    "disposition": "migrate",
+                }
+            ],
+        }
+        ledger_b = {
+            "schema_version": "1.0",
+            "decisions": [
+                {
+                    "id": "repo-001",
+                    "name": "test-repo",
+                    "disposition": "archive",
+                }
+            ],
+        }
+
+        cls.registry_path.write_text(
+            json.dumps(registry, indent=2) + "\n", encoding="utf-8"
+        )
+        cls.ledger_a_path.write_text(
+            json.dumps(ledger_a, indent=2) + "\n", encoding="utf-8"
+        )
+        cls.ledger_b_path.write_text(
+            json.dumps(ledger_b, indent=2) + "\n", encoding="utf-8"
+        )
+
+        cls.report = coverage.report_coverage(
+            registry,
+            [
+                (cls.ledger_a_path, ledger_a),
+                (cls.ledger_b_path, ledger_b),
+            ],
+        )
+
+    def test_unit_counted_as_decided_once(self):
+        self.assertEqual(self.report["totals"]["decided"], 1)
+
+    def test_kind_disposition_sum_is_one(self):
+        kind_data = self.report["per_kind"]["repository"]
+        total = sum(kind_data["dispositions"].values())
+        self.assertEqual(total, 1)
+
+    def test_duplicate_anomaly_flagged(self):
+        anomalies = self.report["anomalies"]["duplicate_decisions"]
+        self.assertEqual(anomalies["count"], 1)
+        self.assertIn("repo-001", anomalies["unit_ids"])
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmpdir.cleanup()
+
+
+class UnknownUnitTests(unittest.TestCase):
+    """A decision for a unit not in the registry must be flagged, not crash."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.tmpdir = tempfile.TemporaryDirectory()
+        cls.tdir = pathlib.Path(cls.tmpdir.name)
+        cls.registry_path = cls.tdir / "registry.json"
+        cls.ledger_path = cls.tdir / "dispositions.json"
+
+        registry = {
+            "migration_units": [
+                {
+                    "id": "repo-001",
+                    "kind": "repository",
+                    "name": "real-repo",
+                    "categories": [],
+                    "disposition": "pending",
+                    "locations": [],
+                    "identities": {},
+                    "provenance": [],
+                    "reconciliation_status": "unreviewed",
+                    "sensitivity": "public",
+                }
+            ]
+        }
+        ledger = {
+            "schema_version": "1.0",
+            "decisions": [
+                {
+                    "id": "repo-001",
+                    "name": "real-repo",
+                    "disposition": "migrate",
+                },
+                {
+                    "id": "repo-999",
+                    "name": "ghost-repo",
+                    "disposition": "discard",
+                },
+            ],
+        }
+
+        cls.registry_path.write_text(
+            json.dumps(registry, indent=2) + "\n", encoding="utf-8"
+        )
+        cls.ledger_path.write_text(
+            json.dumps(ledger, indent=2) + "\n", encoding="utf-8"
+        )
+
+        cls.report = coverage.report_coverage(
+            registry, [(cls.ledger_path, ledger)]
+        )
+
+    def test_no_crash(self):
+        self.assertIsNotNone(self.report)
+
+    def test_real_unit_decided(self):
+        self.assertEqual(self.report["totals"]["decided"], 1)
+
+    def test_unknown_unit_flagged(self):
+        anomalies = self.report["anomalies"]["unknown_units"]
+        self.assertEqual(anomalies["count"], 1)
+        self.assertIn("repo-999", anomalies["unit_ids"])
+
+    def test_unknown_unit_not_counted_in_aggregate(self):
+        self.assertEqual(self.report["aggregate_dispositions"]["discard"], 0)
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmpdir.cleanup()
+
+
+class NoLedgersTests(unittest.TestCase):
+    """No ledgers at all: every unit undecided, coverage incomplete."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.registry = _load(REGISTRY_PATH)
+        cls.report = coverage.report_coverage(cls.registry, [])
+
+    def test_coverage_incomplete(self):
+        self.assertFalse(self.report["totals"]["coverage_complete"])
+
+    def test_all_undecided(self):
+        self.assertEqual(self.report["totals"]["undecided"], 1613)
+        self.assertEqual(self.report["totals"]["decided"], 0)
+
+    def test_all_kinds_undecided(self):
+        for kind_data in self.report["per_kind"].values():
+            self.assertEqual(kind_data["decided_count"], 0)
+            self.assertEqual(
+                kind_data["undecided_count"], kind_data["registry_count"]
+            )
+
+    def test_all_aggregate_dispositions_zero(self):
+        for count in self.report["aggregate_dispositions"].values():
+            self.assertEqual(count, 0)
+
+    def test_no_provenance(self):
+        self.assertEqual(len(self.report["provenance"]), 0)
+
+
+class InvalidDispositionTests(unittest.TestCase):
+    """A disposition outside the five permitted terms must be flagged."""
+
+    @classmethod
+    def setUpClass(cls):
+        cls.tmpdir = tempfile.TemporaryDirectory()
+        cls.tdir = pathlib.Path(cls.tmpdir.name)
+        cls.registry_path = cls.tdir / "registry.json"
+        cls.ledger_path = cls.tdir / "dispositions.json"
+
+        registry = {
+            "migration_units": [
+                {
+                    "id": "repo-001",
+                    "kind": "repository",
+                    "name": "test-repo",
+                    "categories": [],
+                    "disposition": "pending",
+                    "locations": [],
+                    "identities": {},
+                    "provenance": [],
+                    "reconciliation_status": "unreviewed",
+                    "sensitivity": "public",
+                }
+            ]
+        }
+        ledger = {
+            "schema_version": "1.0",
+            "decisions": [
+                {
+                    "id": "repo-001",
+                    "name": "test-repo",
+                    "disposition": "promote",
+                }
+            ],
+        }
+
+        cls.registry_path.write_text(
+            json.dumps(registry, indent=2) + "\n", encoding="utf-8"
+        )
+        cls.ledger_path.write_text(
+            json.dumps(ledger, indent=2) + "\n", encoding="utf-8"
+        )
+
+        cls.report = coverage.report_coverage(
+            registry, [(cls.ledger_path, ledger)]
+        )
+
+    def test_invalid_disposition_flagged(self):
+        anomalies = self.report["anomalies"]["invalid_dispositions"]
+        self.assertEqual(anomalies["count"], 1)
+        self.assertIn("repo-001", anomalies["unit_ids"])
+
+    def test_unit_not_counted_as_decided(self):
+        self.assertEqual(self.report["totals"]["decided"], 0)
+        self.assertEqual(self.report["totals"]["undecided"], 1)
+
+    def test_disposition_not_in_aggregate(self):
+        self.assertNotIn("promote", self.report["aggregate_dispositions"])
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmpdir.cleanup()
+
+
+if __name__ == "__main__":
+    unittest.main()
