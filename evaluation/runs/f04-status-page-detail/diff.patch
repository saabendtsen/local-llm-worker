+
+class HtmlRenderingTests(unittest.TestCase):
+    """Exercise GET / over a port-0 server for status-line and detail rendering."""
+
+    def setUp(self) -> None:
+        self.tmpdir = tempfile.TemporaryDirectory()
+        self.runs = Path(self.tmpdir.name) / "runs"
+        self.runs.mkdir()
+        self._start_server()
+
+    def _start_server(self) -> None:
+        from status_page import DEFAULT_HOST, ThreadingHTTPServer, _StatusHandler
+
+        self._handler_class = type(
+            "_RenderStatusHandler",
+            (_StatusHandler,),
+            {"_runs_dir": self.runs},
+        )
+        self.server = ThreadingHTTPServer((DEFAULT_HOST, 0), self._handler_class)
+        self.port = self.server.server_address[1]
+        self.server_thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.server_thread.start()
+
+    def tearDown(self) -> None:
+        self.server.shutdown()
+        self.tmpdir.cleanup()
+
+    def test_running_status_line(self) -> None:
+        """GET / with a running run titled 'Build <thing>' → title+body contain RUNNING prefix."""
+        _write_started(self.runs, "r1", "task", "Build <thing>",
+                       "2026-08-19T10:00:00+00:00")
+        resp = urlopen(f"http://127.0.0.1:{self.port}/")
+        body = resp.read().decode()
+        self.assertIn("RUNNING: Build &lt;thing&gt;", body)
+
+    def test_idle_status_line_with_finished(self) -> None:
+        """GET / with one finished run → title+body contain 'idle' and finished_at."""
+        run_dir = _write_started(
+            self.runs, "done", "task", "Done",
+            "2026-08-19T09:00:00+00:00",
+        )
+        _write_terminal(run_dir, "run.json", "2026-08-19T09:05:00+00:00")
+        resp = urlopen(f"http://127.0.0.1:{self.port}/")
+        body = resp.read().decode()
+        self.assertIn("idle", body)
+        self.assertIn("2026-08-19T09:05:00+00:00", body)
+
+    def test_verify_passed_false_show_x(self) -> None:
+        """GET / with a finished task whose verify_passed is false → body contains ✗."""
+        run_dir = _write_started(
+            self.runs, "fail", "task", "Failed task",
+            "2026-08-19T09:00:00+00:00",
+        )
+        run_data = {
+            "recorded_at": "2026-08-19T09:05:00+00:00",
+            "verify": {"passed": False},
+        }
+        (run_dir / "run.json").write_text(json.dumps(run_data, indent=2), encoding="utf-8")
+        resp = urlopen(f"http://127.0.0.1:{self.port}/")
+        body = resp.read().decode()
+        self.assertIn("✗", body)
+
+    def test_media_query_present(self) -> None:
+        """GET / → body contains @media (max-width: 600px) and overflow-x."""
+        resp = urlopen(f"http://127.0.0.1:{self.port}/")
+        body = resp.read().decode()
+        self.assertIn("@media (max-width: 600px)", body)
+        self.assertIn("overflow-x", body)
+
+    def test_html_title_matches_status_line(self) -> None:
+        """<title> matches the status line that starts the <body>."""
+        run_dir = _write_started(
+            self.runs, "t1", "task", "Title test",
+            "2026-08-19T10:00:00+00:00",
+        )
+        _write_terminal(run_dir, "run.json", "2026-08-19T10:01:00+00:00")
+        resp = urlopen(f"http://127.0.0.1:{self.port}/")
+        body = resp.read().decode()
+        # Extract title and first body content.
+        import re as _re
+        title_match = _re.search(r"<title>(.*?)</title>", body)
+        self.assertIsNotNone(title_match)
+        title = title_match.group(1)
+        # The first element of body should contain the same text.
+        self.assertIn(title, body)
+
